* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
.styleci.yml export-ignore

# Internal audit / pre-productization history (contains source-project context; never shipped)
docs/audit/ export-ignore

# Discovery 交付物是长期架构基线，冲突时优先保留已提交版本
# （曾连续两次被对话引用文本覆盖，均由 git checkout HEAD -- 恢复）
docs/product/d1-*.md  -merge=ours
docs/product/d2-*.md  -merge=ours
docs/product/d4-*.md  -merge=ours
docs/product/d5-*.md  -merge=ours
