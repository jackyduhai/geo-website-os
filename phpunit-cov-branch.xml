<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnPhpunitDeprecation="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <!-- 分支/路径覆盖的关键业务目录（Xdebug 仅对这些目录插桩，控制运行时长）。
             这是测量范围，不是全仓；其余目录的分支盲区在报告中说明。

             2026-10-27 · V1.4 · F：移出 app/Models。
             原因：path coverage 的路径差集计算是「每个测试 × 每个被插桩文件」
             级别的；app/Models 下是大量声明式数据搬运层（属性 / 关系 / scope），
             分支度量价值低，而插桩文件数直接放大了这条成本曲线 —— CI run
             40452884719 的 coverage job 因此卡在 4 小时以上（同一 commit 的
             非覆盖执行仅 8 分钟）。
             保留的是业务判定层：Gate（生命周期门禁）、Cache（派生输出失效）、
             Middleware（请求级约束）以及两个被它们直接依赖的 Support 类。
             移出范围属于「明确测量口径」，不是删除门禁：分支/路径覆盖率仍然产出，
             测量范围在产物与 CI 日志中显式说明。 -->
        <include>
            <directory>app/Services/Gate</directory>
            <directory>app/Services/Cache</directory>
            <directory>app/Http/Middleware</directory>
            <file>app/Support/SiteContext.php</file>
            <file>app/Support/SiteCacheKey.php</file>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_LOCALE" value="zh-CN"/>
        <env name="APP_FALLBACK_LOCALE" value="zh-CN"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
