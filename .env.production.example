# ============================================================
# GEO Website OS · 生产环境配置模板（部署到云端/宝塔时复制为 .env）
# 复制后逐项修改带【】的项，并执行：php artisan key:generate（若 APP_KEY 为空）
# ============================================================

APP_NAME="GEO Website OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# 【改成正式域名，结尾不带斜杠】
APP_URL=https://www.example.com
# Multi-site production safe default: an unknown Host must NOT fall back to a real
# default site (returns site-not-found), preventing Host-based cross-site serving.
# Set to true only for an explicitly single-site deployment.
SITE_DEFAULT_FALLBACK=false

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------- 数据库 ----------
# 当前项目默认 SQLite（零依赖，单服务器足够）；正式环境也可换 MySQL。
DB_CONNECTION=sqlite
# DB_DATABASE=/www/wwwroot/geo-website-os/database/database.sqlite
#
# 如使用 MySQL，注释上面两行并启用：
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=geo_website_os
# DB_USERNAME=geo_website_os
# DB_PASSWORD=【强密码】

# ---------- 会话 ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 队列：官网当前无异步任务，用 sync 立即执行最稳妥；
# 后续 GEOFlow/邮件若改异步，再切 database 并常驻 queue:work（见 DEPLOY.md）。
QUEUE_CONNECTION=sync

# ---------- 缓存 ----------
# 生产建议 file（比 SQLite 快）；前台整页静态化固定使用文件存储，与此项无关。
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- 邮件（配置真实 SMTP 后，留言通知才能发信）----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- 对象存储（可选，暂用本地 public 盘）----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
